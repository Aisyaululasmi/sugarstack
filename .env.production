# =============================================================================
# SugarStack Production Environment Variables (Railway)
# =============================================================================
# This file documents all variables needed per Railway service.
# DO NOT commit actual secrets. Use Railway dashboard to set these.
#
# Railway syntax: ${{ServiceName.VARIABLE}} creates live references
# that auto-update when the referenced value changes.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVICE: PostgreSQL (Railway managed -- auto-provisioned, no manual setup)
# -----------------------------------------------------------------------------
# Railway auto-creates these on the Postgres service:
#   DATABASE_URL, PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE

# -----------------------------------------------------------------------------
# SERVICE: API (Express.js)
# -----------------------------------------------------------------------------
DATABASE_URL=${{Postgres.DATABASE_URL}}
NODE_ENV=production
PORT=4000
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRES_IN=7d
ALLOWED_ORIGINS=https://${{web.RAILWAY_PUBLIC_DOMAIN}}

# Optional: Uncomment if using AI features
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# SERVICE: Web (Next.js)
# -----------------------------------------------------------------------------
# API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:4000
# NEXT_PUBLIC_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
# NODE_ENV=production
# PORT=3000
