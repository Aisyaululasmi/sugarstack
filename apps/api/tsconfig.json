{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "../..",
    "paths": {
      "@sugarstack/shared": ["../../packages/shared/src"]
    }
  },
  "include": ["src", "../../packages/shared/src"]
}
